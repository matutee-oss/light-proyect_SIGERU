{
    "name": "light/sigeru-backend",
    "description": "SiGeRU - Sistema de Gestión de Residuos Urbanos - Backend API",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "classmap": ["controllers/", "models/", "services/", "helpers/"]
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unitarios",
        "test:integracion": "phpunit --testsuite integracion"
    },
    "config": {
        "sort-packages": true
    }
}
